{
  "name": "myapp-backend",
  "version": "1.0.0",
  "description": "My app backend API",
  "main": "server.js",
  "scripts": {
    "dev": "node --inspect=0.0.0.0:9229 -r ts-node/register src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/index.js",
    "test": "jest",
    "test:auth": "jest --testPathPatterns=tests/auth",
    "test:accounts": "jest --testPathPatterns=tests/accounts",
    "test:youth": "jest --testPathPatterns=tests/youth",
    "test:schools": "jest --testPathPatterns=tests/schools",
    "test:programs": "jest --testPathPatterns=tests/programs",
    "test:cohorts": "jest --testPathPatterns=tests/cohorts",
    "test:homepage": "jest --testPathPatterns=tests/homepage",
    "test:preferences": "jest --testPathPatterns=tests/preferences",
    "test:timesheets": "jest --testPathPatterns=tests/timesheets",
    "test:tasks": "jest --testPathPatterns=tests/tasks",
    "test:docker": "docker-compose exec -e NODE_ENV=test backend sh -c 'npm run db:migrate:test && npm test'",
    "db:migrate:test": "sh -c 'set -a && . ./.env.test && set +a && npx tsx db/scripts/update_schemas.ts'",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:trace": "JEST_SILENT=false jest --verbose",
    "test:verbose": "JEST_VERBOSE=true JEST_SILENT=false jest",
    "db:migrate": "npx tsx db/scripts/update_schemas.ts",
    "db:status": "npx tsx db/scripts/migration_status.ts",
    "db:types": "kysely-codegen --dialect postgres --out-file src/types/database.ts",
    "seed:admin": "npx tsx db/scripts/seed-admin.ts",
    "seed:expression-of-interest": "npx tsx db/scripts/seed-expression-of-interest.ts",
    "seed:programming-demo": "npx tsx db/scripts/seed-programming-demo.ts",
    "seed:timesheet-demo": "npx tsx db/scripts/seed-timesheet-demo.ts",
    "images:backfill-homepage": "npx tsx db/scripts/backfill-homepage-image-variants.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@types/cookie-parser": "^1.4.10",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "2.8.5",
    "dotenv": "^17.2.3",
    "escape-html": "^1.0.3",
    "express": "5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "nodemailer": "^7.0.12",
    "pdfkit": "^0.19.1",
    "postgres": "^3.4.8",
    "sharp": "^0.35.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/escape-html": "^1.0.4",
    "@types/express": "5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^7.0.5",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "googleapis": "^172.0.0",
    "jest": "^30.2.0",
    "kysely": "^0.28.10",
    "kysely-codegen": "^0.19.0",
    "pg": "^8.16.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "10.9.2",
    "tsx": "^4.21.0",
    "typescript": "5.9.3"
  }
}
