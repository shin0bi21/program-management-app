{
  "name": "myapp-backend",
  "version": "1.0.0",
  "description": "My app backend API",
  "main": "server.js",
  "scripts": {
    "dev": "node --inspect=0.0.0.0:9229 -r ts-node/register src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:auth": "jest --testPathPatterns=tests/auth",
    "test:users": "jest --testPathPatterns=tests/users",
    "test:docker": "docker-compose exec backend npm test",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:trace": "JEST_SILENT=false jest --verbose",
    "test:verbose": "JEST_VERBOSE=true JEST_SILENT=false jest",
    "db:migrate": "npx tsx db/scripts/update_schemas.ts",
    "db:migrate:dry": "npx tsx db/scripts/update_schemas.ts --dry-run",
    "db:status": "npx tsx db/scripts/migration_status.ts",
    "db:generate-backup": "npx tsx db/scripts/generate_bu_migration.ts",
    "db:types": "kysely-codegen --dialect postgres --out-file src/types/database.ts",
    "seed:admin": "npx tsx db/scripts/seed-admin.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@types/cookie-parser": "^1.4.10",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "2.8.5",
    "dotenv": "^17.2.3",
    "express": "4.18.2",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^7.0.12",
    "pg": "^8.16.3",
    "postgres": "^3.4.8",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^7.0.5",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "jest": "^30.2.0",
    "kysely": "^0.28.10",
    "kysely-codegen": "^0.19.0",
    "nodemon": "3.0.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "10.9.2",
    "tsx": "^4.21.0",
    "typescript": "5.9.3"
  }
}
