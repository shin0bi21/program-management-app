{
  "name": "myapp-backend",
  "version": "1.0.0",
  "description": "My app backend API",
  "main": "server.js",
  "scripts": {
    "dev": "node --inspect=0.0.0.0:9229 -r ts-node/register src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/index.js",
    "test": "jest",
    "test:auth": "jest --testPathPatterns=tests/auth",
    "test:accounts": "jest --testPathPatterns=tests/accounts",
    "test:youth": "jest --testPathPatterns=tests/youth",
    "test:schools": "jest --testPathPatterns=tests/schools",
    "test:programs": "jest --testPathPatterns=tests/programs",
    "test:sessions": "jest --testPathPatterns='src/(services/programming/sessions/|routes/sessionRoutes[.]test[.]ts$)'",
    "test:homepage": "jest --testPathPatterns=tests/homepage",
    "test:preferences": "jest --testPathPatterns=tests/preferences",
    "test:hours": "jest --testPathPatterns='src/(services/staff/hours/|routes/hoursRoutes[.]test[.]ts$)'",
    "test:reference-data": "jest --testPathPatterns=tests/referenceData",
    "test:tasks": "jest --testPathPatterns=tests/tasks",
    "test:docker": "docker-compose exec -e NODE_ENV=test backend sh -c 'npm run db:migrate:test && npm test'",
    "db:migrate:test": "sh -c 'set -a && . ./.env.test && set +a && npx tsx db/scripts/update_schemas.ts'",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:trace": "JEST_SILENT=false jest --verbose",
    "test:verbose": "JEST_VERBOSE=true JEST_SILENT=false jest",
    "db:migrate": "npx tsx db/scripts/update_schemas.ts",
    "db:status": "npx tsx db/scripts/update_schemas.ts --dry-run",
    "db:types": "kysely-codegen --dialect postgres --date-parser string --out-file src/types/database.ts",
    "seed:admin": "npx tsx db/scripts/seed-admin.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@types/cookie-parser": "^1.4.10",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "2.8.6",
    "dotenv": "^17.2.3",
    "escape-html": "^1.0.3",
    "express": "4.18.2",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "http-errors": "^2.0.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "nodemailer": "^7.0.12",
    "pdfkit": "^0.21.0",
    "postgres": "^3.4.8",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/escape-html": "^1.0.4",
    "@types/express": "5.0.6",
    "@types/http-errors": "^2.0.5",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^7.0.5",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "googleapis": "^172.0.0",
    "jest": "^30.5.2",
    "kysely": "^0.29.9",
    "kysely-codegen": "^0.20.0",
    "pg": "^8.23.1",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-node": "10.9.2",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  }
}
