# Test environment configuration
# Loaded by backend/tests/setup.ts and the db:migrate:test npm script.
# Tests run against an isolated Postgres instance (db_test service in docker-compose),
# so test data never touches the dev database.

# When running via `npm run test:docker` (inside the backend container),
# host is `db_test` (the docker service name).
# When running `npm test` from the host machine, override with localhost:5433.
DATABASE_URL=postgresql://root:supersecretpassword@db_test:5432/myapp_db_test

JWT_SECRET=test-jwt-secret-not-for-production
REFRESH_SECRET=test-refresh-secret-not-for-production

EMAIL_USER=test@example.com
EMAIL_PASS=test
EMAIL_FROM=test@example.com

NODE_ENV=test
