# Database Configuration
DB_HOST=db
DB_USER=your_username
DB_PASSWORD=your_password
DB_NAME=myapp_db
DB_PORT=5432

# Composed connection string
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# For local development outside Docker, uncomment and use:
# DATABASE_URL=postgresql://your_username:your_password@localhost:5432/myapp_db?schema=public

# Authentication
JWT_SECRET=generate_a_secure_random_string_here_use_openssl_rand_hex_64

# Admin User Seeding (for initial setup only)
# Run: npm run seed:admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=SecurePassword123!
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User

# Email Configuration
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-specific-password
EMAIL_FROM="Your App <noreply@yourapp.com>"

# Frontend
FRONTEND_URL=http://localhost:5173
