# ── Database ──────────────────────────────────────────────────────────────────
# DB_HOST: "db" inside Docker (service name). "localhost" if running outside Docker.
DB_HOST=db
DB_USER=your_username
DB_PASSWORD=your_password
DB_NAME=myapp_db
DB_PORT=5432

# docker-compose.yml constructs DATABASE_URL from the vars above — you don't need
# to set it here for Docker dev. Set it explicitly for scripts run outside Docker:
# DATABASE_URL=postgresql://your_username:your_password@localhost:5432/myapp_db

# ── Authentication ────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=generate_a_secure_random_string_here_use_openssl_rand_hex_64
REFRESH_SECRET=generate_a_different_secure_random_string_here_use_openssl_rand_hex_64

# Optional: independent HMAC key for IP hash in auth_log.
# If unset, falls back to JWT_SECRET. Recommended in prod so IP hashes
# remain stable even if JWT_SECRET is rotated.
# LOG_HMAC_SECRET=generate_a_third_secure_random_string_here_use_openssl_rand_hex_64

# ── Environment ───────────────────────────────────────────────────────────────
# "development" locally, "production" on the server.
NODE_ENV=development

# ── Admin Seeding (first-time setup only) ─────────────────────────────────────
# Run: npm run seed:admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=SecurePassword123!
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-specific-password
EMAIL_FROM="Your App <noreply@yourapp.com>"

# ── Frontend ──────────────────────────────────────────────────────────────────
# Dev: http://localhost:5173  |  Prod: https://be-original.ca
FRONTEND_URL=http://localhost:5173

# ── Notifications (optional) ──────────────────────────────────────────────────
# Slack webhook for deploy failure alerts — leave unset to skip
# SLACK_WEBHOOK=https://hooks.slack.com/services/xxx/yyy/zzz

# ── Google Sheets Integration (optional) ──────────────────────────────────────
# Required only for scripts in db/scripts/ that read/write Google Sheets.
# The Express server starts fine without this — it is never loaded at boot.
#
# Setup:
#   1. Create a Google Cloud project and enable the Google Sheets API
#   2. Create a service account and download the JSON key
#   3. Base64-encode it: base64 -i key.json
#   4. Paste the result below (no newlines)
#   5. Share any target Sheet with the service account email (Editor access)
#
# GOOGLE_SERVICE_ACCOUNT_JSON=<base64-encoded service account JSON key>
