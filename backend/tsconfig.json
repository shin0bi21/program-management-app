{
  "compilerOptions": {
    "target": "es2018",
    "module": "commonjs",
    "lib": ["esnext"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "outDir": "./dist",
    "sourceMap": true,
    "types": ["node", "jest"]
  },
  "include": ["src/**/*", "db/**/*", "scripts/**/*", "tests/**/*"],
  "exclude": ["node_modules"]
}