{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "es2018",
    "module": "Node16",
    "lib": ["esnext"],
    "esModuleInterop": true,
    "moduleResolution": "node16",
    "outDir": "./dist",
    "sourceMap": true,
    "types": ["node", "jest"]
  },
  "include": ["src/**/*", "db/**/*", "integrations/**/*", "tests/**/*"],
  "exclude": ["node_modules"]
}
