# Local Docker development settings. Copy this file to .env in the project root.

# ── Database ──────────────────────────────────────────────────────────────────
# Ready-to-use credentials for local development only.
# "db" is the database service in Docker.
DB_HOST=db
DB_USER=local_app
DB_PASSWORD=local_password
DB_NAME=myapp_db
DB_PORT=5432

# Docker Compose builds DATABASE_URL from the settings above.

# ── Authentication ────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=generate_a_secure_random_string_here_use_openssl_rand_hex_64
REFRESH_SECRET=generate_a_different_secure_random_string_here_use_openssl_rand_hex_64

# ── Environment ───────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Local Administrator ──────────────────────────────────────────────────────
# Created automatically on startup. Existing accounts are left unchanged.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=SecurePassword123!
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
