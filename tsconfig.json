{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2024"],
    "module": "Node16",
    "moduleResolution": "Node16",
    "types": ["node"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": ["scripts/**/*.ts"],
  "exclude": ["node_modules"]
}
